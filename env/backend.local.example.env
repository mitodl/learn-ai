# Zendesk ticket creation for the support intake bot.
# Turn stub mode on for local work, so intake never files a real ticket. It
# defaults off, so an environment that forgets it fails loudly instead.
AI_ZENDESK_STUB_MODE=True
# The canonical API host, not the branded help center used by article search.
# AI_ZENDESK_API_URL=https://<subdomain>.zendesk.com
# OAuth client_credentials from a confidential OAuth client (Admin Center > Apps
# and integrations > APIs > OAuth Clients). API tokens stop working 2027-04-30
# and new accounts cannot create them, so OAuth is the only path. The backend
# mints and caches a short-lived access token from these.
# AI_ZENDESK_OAUTH_CLIENT_ID=
# AI_ZENDESK_OAUTH_CLIENT_SECRET=
# Custom ticket field ids, from Admin Center > Objects and rules > Tickets >
# Fields. Minted per Zendesk instance, so each environment has its own. Leave
# unset and the value is simply left off the ticket.
# AI_ZENDESK_URL_FIELD_ID=
# AI_ZENDESK_NAME_FIELD_ID=
# AI_ZENDESK_USERNAME_FIELD_ID=

# Sends the chat thread cookies as SameSite=None;Secure, which a widget
# embedded outside mit.edu needs. Off by default, and it covers every bot.
# Turning it on requires CORS_ALLOW_ORIGINS to name the embedding origins -
# the pair is refused otherwise. Browsers also reject Secure cookies over
# plain HTTP, so locally prefer a host that shares the registrable domain of
# the embedding page over turning this on.
# AI_CHATBOTS_COOKIE_CROSS_SITE=True
