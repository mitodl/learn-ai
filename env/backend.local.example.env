#Langsmith settings
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Posthog settings
# POSTHOG_PROJECT_ID=
# POSTHOG_PERSONAL_API_KEY=

# Zendesk ticket creation for the support intake bot.
# Turn stub mode on for local work, so intake never files a real ticket. It
# defaults off, so an environment that forgets it fails loudly instead.
AI_ZENDESK_STUB_MODE=True
# The canonical API host, not the branded help center used by article search.
# AI_ZENDESK_API_URL=https://<subdomain>.zendesk.com
# An OAuth access token. API tokens stop working 2027-04-30; new Zendesk
# accounts cannot create them at all, so OAuth is the only path.
# AI_ZENDESK_OAUTH_TOKEN=

# Chat thread cookies carry SameSite=None;Secure so the widgets work when
# embedded on another origin. Browsers reject Secure cookies over plain HTTP,
# so turn this off locally and reach learn-ai on a host that shares the
# registrable domain of the page embedding the widget.
# AI_CHATBOTS_COOKIE_CROSS_SITE=False
